#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# branch checkouts only, not file checkouts
[ "$3" = "1" ] || exit 0

# new worktree: no previous HEAD (null SHA) to diff against, it links deps
# with scripts/setup-worktree.sh instead
git rev-parse -q --verify "$1^{commit}" >/dev/null || exit 0

# skip if the lockfile and .nvmrc didn't change
git diff --quiet "$1" "$2" -- pnpm-lock.yaml .nvmrc && exit 0

# sandboxed agent shells can't reach the registry — leave installs to the human
if [ -n "$SANDBOX_RUNTIME" ]; then
  echo "post-checkout: pnpm-lock.yaml or .nvmrc changed, but skipped install (sandboxed shell, no registry access)."
  echo "post-checkout: dependencies may be stale — ask the user to run: nvm use && pnpm i"
  exit 0
fi

# Load nvm
export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  # nvm not available, quietly exit
  exit 0
fi
. "$NVM_DIR/nvm.sh"

nvm use || nvm install
pnpm i --config.confirm-modules-purge=false || echo "post-checkout: pnpm i failed (non-fatal)"
exit 0