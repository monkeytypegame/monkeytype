#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# branch checkouts only, not file checkouts
[ "$3" = "1" ] || exit 0

# skip if the lockfile and .nvmrc didn't change
git diff --quiet "$1" "$2" -- pnpm-lock.yaml .nvmrc && exit 0

# Load nvm
export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  # nvm not available, quietly exit
  exit 0
fi
. "$NVM_DIR/nvm.sh"

nvm use || nvm install
pnpm i --config.confirm-modules-purge=false || echo "post-checkout: pnpm i failed (non-fatal)"
exit 0