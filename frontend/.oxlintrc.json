{
  "ignorePatterns": ["node_modules", "dist", "coverage", ".firebase", ".turbo"],
  "extends": [
    ".oxlintrc.core.json",
    "../packages/oxlint-config/index.jsonc",
    "../packages/oxlint-config/plugin.jsonc"
    // "@monkeytype/oxlint-config"
  ],
  "jsPlugins": ["eslint-plugin-compat"],
  "rules": {
    "compat/compat": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        "monkeytype-rules/no-module-scope-dom-query": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/config/store"],
                "importNames": ["Config"],
                "message": "Read config through the getConfig store; the mutable Config object is config/'s own (deleted in C4)."
              }
            ]
          }
        ]
      }
    },
    {
      // the mutable config object lives here until C4
      "files": ["src/ts/config/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // input layer: browser input → engine commands and render buffer
      // writes, never UI (docs/specs/solid-monkeytype/spec.md)
      "files": ["src/ts/input/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/config/store"],
                "importNames": ["Config"],
                "message": "Read config through the getConfig store; the mutable Config object is config/'s own (deleted in C4)."
              },
              {
                "group": ["**/components/**", "**/elements/**"],
                "message": "The input layer never imports UI: write to states or the render buffer instead."
              }
            ]
          }
        ]
      }
    },
    {
      // test engine: DOM-free, owns its state; may read the data layer
      // (config, states, collections) (docs/specs/solid-monkeytype/spec.md)
      "files": ["src/ts/test/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/config/store"],
                "importNames": ["Config"],
                "message": "Read config through the getConfig store; the mutable Config object is config/'s own (deleted in C4)."
              },
              {
                "group": [
                  "**/components/**",
                  "**/elements/**",
                  "**/input/**",
                  "**/controllers/**",
                  "**/audio",
                  "**/audio/**",
                  "**/theme",
                  "**/theme/**",
                  // the theme state is data
                  "!**/theme/state",
                  // integrations, except Sentry: the engine may report errors
                  "**/integrations/ads",
                  "**/integrations/ads/**",
                  "**/integrations/analytics",
                  "**/pages/**",
                  "**/anim"
                ],
                "message": "The engine never imports UI or input: expose a signal and react to it outside the engine."
              },
              {
                "group": [
                  "**/test-logic",
                  "**/test-page-bridge",
                  "**/timer-effects",
                  "**/pace-caret",
                  "**/words-generator",
                  "**/funbox/**",
                  "**/custom-text"
                ],
                "message": "The engine never imports the test modules around it (test-logic, funbox, custom text): they call the engine."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          { "name": "document", "message": "The engine has no DOM access." },
          { "name": "HTMLElement", "message": "The engine has no DOM access." },
          { "name": "Element", "message": "The engine has no DOM access." }
        ]
      }
    },
    {
      "jsPlugins": ["eslint-plugin-solid", "@tanstack/eslint-plugin-query"],
      "files": ["src/**/*.tsx"],
      "rules": {
        "explicit-function-return-type": "off",
        "solid/components-return-once": "error",
        "solid/event-handlers": "error",
        "solid/imports": "error",
        "solid/jsx-no-duplicate-props": "error",
        "solid/jsx-no-script-url": "error",
        "solid/jsx-no-undef": "error",
        "solid/no-array-handlers": "error",
        "solid/no-destructure": "error",
        "solid/no-innerhtml": "error",
        "solid/no-react-deps": "error",
        "solid/no-react-specific-props": "error",
        "solid/no-unknown-namespaces": "error",
        "solid/prefer-for": "error",
        "solid/prefer-show": "error",
        "solid/reactivity": "error",
        "solid/self-closing-comp": [
          "error",
          {
            "html": "void"
          }
        ],
        "solid/style-prop": "error",
        "@tanstack/query/exhaustive-deps": "error",
        "@tanstack/query/no-rest-destructuring": "error",
        "@tanstack/query/stable-query-client": "error",
        "@tanstack/query/no-unstable-deps": "error",
        "@tanstack/query/infinite-query-property-order": "error",
        "@tanstack/query/no-void-query-fn": "error",
        "@tanstack/query/mutation-property-order": "error"
      }
    }
  ]
}
